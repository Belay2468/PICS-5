*, *::before, *::after {
  box-sizing: border-box;
}

html, body {
  height: 100%;
}

* {
  margin: 0;
  padding: 0;
}

ul, li {
  list-style: none;
}

a {
  color: #15803d;
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

button {
  font-family: inherit;
  cursor: pointer;
}

input, select, textarea {
  font-family: inherit;
  font-size: inherit;
}

:focus-visible {
  outline: 2px solid #16a34a;
  outline-offset: 2px;
}

html {
  font-size: 100%;
}

body {
  font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 14.5px;
  line-height: 1.5;
  background: #f4f6f5;
  color: #1f2937;
}

h1, h2, h3, h4 {
  margin: 0 0 4px;
  font-weight: 700;
  letter-spacing: -0.01em;
}

p {
  margin: 0 0 8px;
}

.container {
  max-width: 120rem;
  width: 100%;
  padding: 1.5rem;
  margin: 0 auto;
}

.admin-shell {
  display: flex;
  min-height: 100vh;
  background: #f8faf9;
}

.main-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.content {
  padding: 26px 28px 60px;
}

.panel-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

@media (max-width: 1000px) {
  .panel-grid-2 {
    grid-template-columns: 1fr;
  }
}
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(220px, 1fr));
  gap: 18px;
  margin-bottom: 22px;
}

@media (max-width: 1240px) {
  .stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 560px) {
  .stat-grid {
    grid-template-columns: 1fr;
  }
}
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.item-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  align-items: start;
}

@media (max-width: 900px) {
  .item-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 600px) {
  .item-grid {
    grid-template-columns: 1fr;
  }
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

@media (max-width: 600px) {
  .form-row {
    grid-template-columns: 1fr;
  }
}
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 20px;
}

.text-muted {
  color: #6b7280;
}

.text-warning {
  color: #d97706;
}

.text-center {
  text-align: center;
}

.cell-strong {
  font-weight: 600;
}

.cell-muted {
  color: #6b7280;
}

.flex {
  display: flex;
}

.flex-wrap {
  flex-wrap: wrap;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.gap-8 {
  gap: 8px;
}

.mt-0 {
  margin-top: 0;
}

.mb-0 {
  margin-bottom: 0;
}

.w-full {
  width: 100%;
}

.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.badge-success {
  background: #dcfce7;
  color: #16a34a;
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.badge-warning {
  background: #fef3c7;
  color: #d97706;
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.badge-danger {
  background: #fee2e2;
  color: #dc2626;
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.badge-info {
  background: #dbeafe;
  color: #2563eb;
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.badge-muted {
  background: #f4f6f5;
  color: #6b7280;
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.alert {
  padding: 12px 16px;
  border-radius: 6px;
  font-size: 13px;
  margin-bottom: 18px;
  border: 1px solid transparent;
}
.alert-success {
  background: #dcfce7;
  color: #14532d;
  border-color: #bbf7d0;
}
.alert-danger {
  background: #fee2e2;
  color: #991b1b;
  border-color: #fecaca;
}
.alert-info {
  background: #dbeafe;
  color: #1e3a8a;
  border-color: #bfdbfe;
}

@media print {
  .no-print {
    display: none !important;
  }
  body {
    background: #fff;
  }
}
.sidebar {
  width: 248px;
  background: #ffffff;
  border-right: 1px solid #e5e7eb;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  flex-shrink: 0;
}
.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 18px 20px;
  border-bottom: 1px solid #e5e7eb;
}
.sidebar-brand .icon {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #16a34a;
  color: #ffffff;
  font-size: 16px;
}
.sidebar-brand .name {
  font-size: 14.5px;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
}
.sidebar-brand .tag {
  margin-top: 3px;
  font-size: 10.5px;
  color: #6b7280;
}
.sidebar-nav {
  flex: 1;
  padding: 18px 12px;
  overflow-y: auto;
}
.sidebar-nav ul {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.sidebar-nav .nav-link {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 14px;
  border-radius: 12px;
  color: #6b7280;
  font-size: 13.5px;
  font-weight: 500;
  transition: 0.2s ease;
}
.sidebar-nav .nav-link .ico {
  width: 20px;
  display: flex;
  justify-content: center;
  font-size: 15px;
}
.sidebar-nav .nav-link:hover {
  background: #f0fdf4;
  color: #15803d;
  transform: translateX(3px);
  text-decoration: none;
}
.sidebar-nav .nav-link.active {
  background: #dcfce7;
  color: #14532d;
  font-weight: 700;
}
.sidebar-nav .nav-link.active::before {
  content: "";
  position: absolute;
  left: -12px;
  top: 8px;
  height: calc(100% - 16px);
  width: 4px;
  background: #16a34a;
  border-radius: 0 6px 6px 0;
}
.sidebar-foot {
  padding: 14px 12px;
  border-top: 1px solid #e5e7eb;
}
.sidebar-foot .nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 14px;
  border-radius: 12px;
  color: #dc2626;
}
.sidebar-foot .nav-link:hover {
  background: #fee2e2;
  color: #dc2626;
  text-decoration: none;
}

.sidebar-toggle {
  display: none;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  background: #ffffff;
  color: #1f2937;
  font-size: 16px;
}
.sidebar-toggle:hover {
  background: #f4f6f5;
}

.sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 190;
  background: rgba(15, 23, 18, 0.45);
}
.sidebar-backdrop.open {
  display: block;
}

@media (max-width: 900px) {
  .sidebar-toggle {
    display: flex;
  }
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 200;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    box-shadow: 0 12px 32px rgba(16, 24, 16, 0.14);
  }
  .sidebar.open {
    transform: translateX(0);
  }
}
.topbar {
  height: 73px;
  background: #ffffff;
  border-bottom: 1px solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 24px;
  position: sticky;
  top: 0;
  z-index: 10;
}
.topbar .topbar-right {
  display: flex;
  align-items: center;
  gap: 18px;
}
.topbar .bell {
  position: relative;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #6b7280;
  font-size: 17px;
  transition: 0.2s ease;
}
.topbar .bell:hover {
  background: #f0fdf4;
  color: #15803d;
}
.topbar .bell .dot {
  position: absolute;
  top: 5px;
  right: 6px;
  width: 9px;
  height: 9px;
  background: #dc2626;
  border-radius: 50%;
  border: 2px solid #fff;
}
.topbar .user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 12px 6px 6px;
  border: 1px solid #e5e7eb;
  border-radius: 999px;
  background: #ffffff;
  transition: 0.2s ease;
}
.topbar .user-chip .avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #16a34a;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
}
.topbar .user-chip .meta {
  line-height: 1.2;
}
.topbar .user-chip .meta .name {
  font-size: 13px;
  font-weight: 600;
  color: #1f2937;
}
.topbar .user-chip .meta .role {
  font-size: 11.5px;
  color: #6b7280;
  margin-top: 2px;
}

.user-shell {
  min-height: 100vh;
  padding-top: 74px;
}

.user-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36px;
  background: linear-gradient(90deg, #15803d 0%, #16a34a 100%);
  color: #fff;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
  color: #fff;
}
.brand .icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
  flex-shrink: 0;
}
.brand div:last-child {
  display: flex;
  flex-direction: column;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.1;
}
.brand small {
  margin-top: 4px;
  font-size: 12px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.82);
}

.user-topbar-right {
  display: flex;
  align-items: center;
  gap: 18px;
}

.logout-link {
  display: flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  color: rgba(255, 255, 255, 0.95);
  font-size: 14px;
  font-weight: 600;
  transition: 0.25s;
  padding: 8px 12px;
  border-radius: 8px;
}
.logout-link:hover {
  background: rgba(255, 255, 255, 0.12);
}
.logout-link i {
  font-size: 15px;
}

.divider {
  width: 1px;
  height: 26px;
  background: rgba(255, 255, 255, 0.25);
}

.clock {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.2);
  font-size: 14px;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
}
.clock i {
  font-size: 15px;
}
.clock #liveClock {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.clock .clock-time {
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
}
.clock .clock-info {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  opacity: 0.9;
}
.clock .clock-divider {
  width: 1px;
  height: 12px;
  background: rgba(255, 255, 255, 0.4);
}
.clock .clock-date,
.clock .clock-day {
  line-height: 1;
}

.avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #ffffff;
  color: #15803d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 15px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
}

.user-topbar .user-chip {
  display: flex;
  align-items: center;
  gap: 12px;
}
.user-topbar .user-chip .meta {
  display: flex;
  flex-direction: column;
}
.user-topbar .user-chip .meta .name {
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
}
.user-topbar .user-chip .meta .role {
  margin-top: 2px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 12px;
}

@media (max-width: 992px) {
  .user-topbar {
    padding: 0 20px;
  }
  .user-topbar .user-chip .meta {
    display: none;
  }
  .clock {
    display: none;
  }
}
@media (max-width: 768px) {
  .user-topbar {
    height: auto;
    padding: 15px 18px;
    flex-direction: column;
    gap: 14px;
  }
  .user-shell {
    padding-top: 135px;
  }
  .user-topbar-right {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
}
.ico {
  width: 22px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  margin-right: 0.75rem;
  font-size: 1rem;
}

.search-box .ico,
.bell {
  color: #64748b;
}

.nav-link i,
.bell i {
  transition: 0.2s ease;
}

.nav-link:hover i {
  transform: scale(1.1);
}

@media (max-width: 900px) {
  .topbar {
    justify-content: space-between;
    padding: 0 16px;
  }
}
.user-footer {
  text-align: center;
  padding: 24px;
  font-size: 11.5px;
  color: #7c8592;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 9px 16px;
  border-radius: 6px;
  border: 1px solid transparent;
  font-size: 13px;
  font-weight: 600;
  transition: filter 0.15s ease, background 0.15s ease;
}
.btn:hover {
  text-decoration: none;
  filter: brightness(0.96);
}
.btn-primary {
  background: #16a34a;
  color: #ffffff;
}
.btn-primary:hover {
  background: #15803d;
}
.btn-outline {
  background: #ffffff;
  color: #1f2937;
  border-color: #e5e7eb;
}
.btn-outline:hover {
  background: #f4f6f5;
}
.btn-danger {
  background: #fee2e2;
  color: #dc2626;
}
.btn-success {
  background: #dcfce7;
  color: #16a34a;
}
.btn-ghost {
  background: transparent;
  color: #6b7280;
  padding: 6px 8px;
}
.btn-ghost:hover {
  background: #f4f6f5;
}
.btn-sm {
  padding: 6px 10px;
  font-size: 12px;
}
.btn-block {
  width: 100%;
}

.icon-btn {
  width: 30px;
  height: 30px;
  border-radius: 6px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
}
.icon-btn:hover {
  background: #f4f6f5;
  text-decoration: none;
}
.icon-btn.danger:hover {
  background: #fee2e2;
  color: #dc2626;
}

.stat-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  box-shadow: 0 1px 2px rgba(16, 24, 16, 0.06);
  min-height: 135px;
  padding: 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 16px;
  transition: 0.25s ease;
}
.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 4px 14px rgba(16, 24, 16, 0.08);
}
.stat-card .stat-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.stat-card .stat-label {
  font-size: 13px;
  font-weight: 600;
  color: #6b7280;
  margin-bottom: 10px;
}
.stat-card .stat-value {
  font-size: 38px;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 6px;
}
.stat-card .stat-sub {
  font-size: 12px;
  color: #6b7280;
}
.stat-card .stat-icon {
  width: 58px;
  height: 58px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  flex-shrink: 0;
}
.stat-card .stat-icon.ic-green {
  background: #dcfce7;
  color: #16a34a;
}
.stat-card .stat-icon.ic-blue {
  background: #dbeafe;
  color: #2563eb;
}
.stat-card .stat-icon.ic-amber {
  background: #fef3c7;
  color: #d97706;
}
.stat-card .stat-icon.ic-red {
  background: #fee2e2;
  color: #dc2626;
}

.panel {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  box-shadow: 0 1px 2px rgba(16, 24, 16, 0.06);
  padding: 20px;
  margin-bottom: 20px;
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
  gap: 10px;
  flex-wrap: wrap;
}
.panel-head h3 {
  font-size: 15px;
}

.users-panel-head {
  margin-bottom: 18px;
}
.users-panel-head .panel-subtitle {
  margin-top: 2px;
  font-size: 13px;
  color: #6b7280;
}
.users-panel-head .users-filter {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-direction: row;
  flex-wrap: wrap;
}
.users-panel-head .users-filter .form-control {
  width: 170px;
}

@media (max-width: 420px) {
  .users-filter .form-control {
    width: 100%;
  }
}
.item-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  transition: 0.25s;
}
.item-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.1);
}

.item-image {
  width: 120px;
  height: 110px;
  border-radius: 12px;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.item-image img {
  width: 100%;
  height: 100%;
  -o-object-fit: contain;
     object-fit: contain;
  padding: 8px;
}
.item-image i {
  font-size: 45px;
  color: #16a34a;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-info h3 {
  font-size: 18px;
  margin-bottom: 6px;
  color: #111827;
}

.item-code {
  color: #6b7280;
  margin-bottom: 12px;
}

.item-qty-label {
  font-size: 13px;
  color: #6b7280;
}

.item-qty {
  font-size: 30px;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10px;
}
.item-qty span {
  font-size: 18px;
  color: #6b7280;
  font-weight: 500;
}

.item-info .badge {
  width: -moz-max-content;
  width: max-content;
  margin-bottom: 12px;
}

.item-info .btn {
  width: 160px;
}

@media (max-width: 480px) {
  .item-card {
    flex-direction: column;
    align-items: stretch;
  }
  .item-image {
    width: 100%;
    height: 160px;
  }
  .item-info .btn {
    width: 100%;
  }
}
.category-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  min-height: 110px;
  border-radius: 14px;
  overflow: hidden;
  text-decoration: none;
  color: #fff;
  background: linear-gradient(135deg, #16a34a, #22c55e);
  box-shadow: 0 4px 14px rgba(16, 24, 16, 0.08);
  transition: 0.25s ease;
}
.category-card:hover {
  background: linear-gradient(135deg, #15803d, #16a34a);
  transform: translateY(-4px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
  text-decoration: none;
  color: #fff;
}
.category-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 10% 15%, rgba(255, 255, 255, 0.08) 8px, transparent 9px), radial-gradient(circle at 28% 70%, rgba(255, 255, 255, 0.07) 16px, transparent 17px), radial-gradient(circle at 55% 35%, rgba(255, 255, 255, 0.05) 12px, transparent 13px), radial-gradient(circle at 82% 18%, rgba(255, 255, 255, 0.07) 18px, transparent 19px), radial-gradient(circle at 92% 78%, rgba(255, 255, 255, 0.05) 10px, transparent 11px), radial-gradient(circle at 65% 90%, rgba(255, 255, 255, 0.08) 20px, transparent 21px), radial-gradient(circle at 38% 8%, rgba(255, 255, 255, 0.05) 14px, transparent 15px);
}
.category-card::after {
  content: "";
  position: absolute;
  top: -60px;
  right: -60px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.08);
}
.category-card > * {
  position: relative;
  z-index: 1;
}

.category-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #fff;
  color: #16a34a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.category-info {
  flex: 1;
}

.category-info h2 {
  font-size: 16px;
  margin-bottom: 6px;
  font-weight: 700;
}

.category-info p {
  font-size: 11px;
  line-height: 1.6;
  opacity: 0.95;
  margin-bottom: 10px;
}

.category-count {
  display: inline-block;
  padding: 5px 10px;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  font-size: 11px;
}

.category-arrow {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}

.thumb {
  height: 110px;
  border-radius: 12px;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 12px;
}
.thumb img {
  width: 100%;
  height: 100%;
  -o-object-fit: cover;
     object-fit: cover;
}
.thumb i {
  font-size: 42px;
  color: #16a34a;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 18, 0.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 80px 20px 20px;
  overflow-y: auto;
  z-index: 100;
}
.modal-backdrop.open {
  display: flex;
}

.modal {
  background: #ffffff;
  border-radius: 16px;
  width: 100%;
  max-width: 480px;
  max-height: 80vh;
  height: auto;
  overflow-y: auto;
  box-shadow: 0 12px 32px rgba(16, 24, 16, 0.14);
}
.modal.modal-lg {
  max-width: 640px;
}
.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid #e5e7eb;
}
.modal-head h3 {
  font-size: 15.5px;
  color: #14532d;
}
.modal-head {
  background: #f0fdf4;
  border-radius: 16px 16px 0 0;
}
.modal-body {
  padding: 20px 22px;
}
.modal-foot {
  padding: 16px 22px;
  border-top: 1px solid #e5e7eb;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}
.modal-close {
  background: transparent;
  border: none;
  font-size: 18px;
  color: #6b7280;
  line-height: 1;
}

#requestModal .modal {
  max-width: 560px;
}

.details-image {
  width: 160px;
  height: 160px;
  background: #f8fafc;
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.details-image img {
  width: 100%;
  height: 100%;
  -o-object-fit: contain;
     object-fit: contain;
  padding: 10px;
}
.details-image .details-placeholder {
  font-size: 60px;
}

.details-info .form-group {
  margin-bottom: 12px;
}

.table-wrap {
  overflow-x: auto;
}

table.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
table.data-table th {
  text-align: left;
  padding: 10px 14px;
  background: #f4f6f5;
  color: #6b7280;
  font-size: 11.5px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  border-bottom: 1px solid #e5e7eb;
  white-space: nowrap;
}
table.data-table td {
  padding: 12px 14px;
  border-bottom: 1px solid #e5e7eb;
  vertical-align: middle;
}
table.data-table tr:last-child td {
  border-bottom: none;
}
table.data-table tr:hover td {
  background: #f0fdf4;
}

.row-actions {
  display: flex;
  gap: 6px;
}

.empty-row td {
  text-align: center;
  padding: 34px;
  color: #6b7280;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-direction: row;
  padding: 16px 20px;
  margin-bottom: 22px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  box-shadow: 0 1px 2px rgba(16, 24, 16, 0.06);
  flex-wrap: wrap;
}
.filter-bar .search-grow {
  flex: 1;
  min-width: 220px;
  max-width: none;
}
.filter-bar .form-control {
  width: 180px;
  height: 42px;
  border-radius: 10px;
  flex-shrink: 0;
}
.filter-bar .btn {
  height: 42px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 10px;
  flex-shrink: 0;
  white-space: nowrap;
}

@media (max-width: 600px) {
  .filter-bar .search-grow {
    min-width: 100%;
  }
  .filter-bar .form-control,
  .filter-bar .btn {
    width: 100%;
  }
}
.form-group {
  margin-bottom: 16px;
}
.form-group label {
  display: block;
  margin-bottom: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #1f2937;
}
.form-group .hint {
  margin-top: 5px;
  font-size: 11px;
  color: #6b7280;
}

.form-control {
  width: 100%;
  height: 42px;
  padding: 0 14px;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  background: #fff;
  color: #1f2937;
  font-size: 13.5px;
  line-height: 1.4;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.form-control:hover {
  border-color: rgba(22, 163, 74, 0.45);
}
.form-control:focus {
  outline: none;
  border-color: #16a34a;
  box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
}
.form-control:disabled {
  background: #f4f6f5;
  color: #6b7280;
  cursor: not-allowed;
}

textarea.form-control {
  min-height: 90px;
  padding: 12px 14px;
  resize: vertical;
}

select.form-control {
  cursor: pointer;
}

.form-file {
  width: 100%;
  padding: 8px;
  border: 1px dashed #d1d5db;
  border-radius: 8px;
  background: #f9fafb;
  font-size: 13px;
  color: #6b7280;
  transition: 0.2s ease;
}
.form-file:hover {
  border-color: #16a34a;
  background: #f0fdf4;
}
.form-file:focus {
  outline: none;
  border-color: #16a34a;
  box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
}
.form-file::file-selector-button {
  margin-right: 12px;
  padding: 8px 14px;
  border: none;
  border-radius: 6px;
  background: #16a34a;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}
.form-file::file-selector-button:hover {
  background: #15803d;
}

.tabs {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid #e5e7eb;
  margin-bottom: 18px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.tab-link {
  padding: 10px 16px;
  font-size: 13px;
  font-weight: 600;
  color: #6b7280;
  border-bottom: 2px solid transparent;
  flex-shrink: 0;
  white-space: nowrap;
}
.tab-link.active {
  color: #15803d;
  border-color: #16a34a;
}
.tab-link:hover {
  text-decoration: none;
  color: #15803d;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 14px;
  height: 160px;
  padding-top: 10px;
}
.bar-chart .bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.bar-chart .bar {
  width: 60%;
  border-radius: 4px 4px 0 0;
  background: #16a34a;
}
.bar-chart .bar-label {
  margin-top: 8px;
  font-size: 11px;
  color: #6b7280;
}

.legend {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 14px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12.5px;
}
.legend-item .pct {
  margin-left: auto;
  font-weight: 700;
  color: #6b7280;
}

.legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  flex-shrink: 0;
}

.donut-wrap {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: wrap;
}

.donut {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  flex-shrink: 0;
}

body.loginpage {
  margin: 0;
  background: linear-gradient(rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0.6)), url("../img/login-bg.png") center/cover no-repeat fixed;
}

.login-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30px;
}

.login-card {
  width: 760px;
  max-width: 100%;
  margin: 0 auto;
  background: #fff;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
}

.login-container {
  display: flex;
}

.left {
  width: 42%;
  background: linear-gradient(160deg, #046c4e, #059669);
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 2rem;
}

.logo-badge {
  width: 90px;
  height: 90px;
  margin-bottom: 1.25rem;
}
.logo-badge img {
  width: 100%;
  height: 100%;
  -o-object-fit: contain;
     object-fit: contain;
}

.left h1 {
  font-size: 1.7rem;
  margin-bottom: 0.5rem;
  letter-spacing: 0.5px;
}

.subtitle {
  font-size: 0.9rem;
  line-height: 1.7;
  max-width: 220px;
  opacity: 0.9;
}

.right {
  width: 58%;
  padding: 2rem 2.3rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.field {
  display: flex;
  flex-direction: column;
}

.field label {
  font-size: 0.9rem;
  font-weight: bold;
  color: #374151;
  margin-bottom: 0.45rem;
}

.field input {
  height: 45px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  padding: 0 0.9rem;
  transition: 0.25s;
}

.field input:focus {
  outline: none;
  border-color: #16a34a;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
}

.login-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.82rem;
}

.login-row label {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.login-row a {
  color: #16a34a;
  font-weight: 600;
}

.btn {
  height: 45px;
  border: none;
  border-radius: 8px;
  background: #16a34a;
  color: #fff;
  font-weight: 600;
  font-size: 0.95rem;
  transition: 0.25s;
}

.btn:hover {
  background: #15803d;
}

.login-foot {
  text-align: center;
  padding: 0.5rem;
  font-size: 0.78rem;
  color: #6b7280;
  border-top: 1px solid #ececec;
  background: #fafafa;
  opacity: 0.6;
}

/* ==========================================================
   Demo Modal
========================================================== */
.demo-link {
  margin-top: 16px;
  text-align: center;
}

.demo-link a {
  color: #16a34a;
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  transition: 0.2s;
}

.demo-link a:hover {
  color: #15803d;
  text-decoration: underline;
}

.demo-modal {
  position: fixed;
  inset: 0;
  display: none;
  justify-content: center;
  align-items: center;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(6px);
  z-index: 9999;
}

.demo-modal.show {
  display: flex;
}

.demo-box {
  width: 380px;
  max-width: 92%;
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  border-top: 5px solid #16a34a;
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.22);
  animation: demoPopup 0.22s ease;
}

.demo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  background: #f8fafc;
  border-bottom: 1px solid #e5e7eb;
}

.demo-header h3 {
  margin: 0;
  font-size: 1rem;
  color: #16a34a;
  font-weight: 700;
}

.demo-header button {
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 50%;
  background: transparent;
  font-size: 20px;
  color: #6b7280;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
  line-height: 1;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.demo-header button:hover {
  background: #fee2e2;
  color: #dc2626;
}
.demo-header button:hover i {
  color: #dc2626;
}

.demo-body {
  padding: 16px;
}

/* ==========================================================
   First Time Setup
========================================================== */
.setup-info {
  background: #ecfdf5;
  border: 1px solid #bbf7d0;
  border-left: 4px solid #16a34a;
  border-radius: 8px;
  padding: 12px 14px;
  margin-bottom: 14px;
}

.setup-info h4 {
  margin: 0 0 6px;
  font-size: 0.95rem;
  color: #16a34a;
}

.setup-info p {
  margin: 0 0 8px;
  font-size: 0.78rem;
  color: #374151;
}

.setup-info ol {
  margin: 0 0 0 18px;
  padding: 0;
  font-size: 0.76rem;
  line-height: 1.6;
}

.setup-info code {
  background: #fff;
  padding: 2px 5px;
  border-radius: 4px;
}

/* ==========================================================
   Accounts
========================================================== */
.account {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-left: 4px solid #16a34a;
  border-radius: 8px;
  padding: 12px;
}

.account h4 {
  margin: 0 0 8px;
  font-size: 0.92rem;
  color: #16a34a;
}

.demo-group {
  padding: 12px 0;
}
.demo-group:not(:last-child) {
  border-bottom: 1px solid #e5e7eb;
  margin-bottom: 10px;
}
.demo-group h5 {
  margin: 0 0 10px;
  color: #16a34a;
  font-size: 0.9rem;
}

.demo-row {
  display: grid;
  grid-template-columns: 80px 1fr;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.demo-row span {
  font-size: 0.75rem;
  font-weight: 600;
  color: #6b7280;
}

.demo-row code {
  display: block;
  background: #fff;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  padding: 7px 10px;
  font-size: 0.76rem;
}

.demo-note {
  margin-top: 14px;
  text-align: center;
  font-size: 0.72rem;
  color: #6b7280;
}

@keyframes demoPopup {
  from {
    opacity: 0;
    transform: translateY(-10px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
@media (max-width: 860px) {
  .login-page .container {
    padding: 0;
  }
  .login-card {
    width: 100%;
    max-width: 480px;
  }
  .login-container {
    flex-direction: column;
  }
  .left,
  .right {
    width: 100%;
  }
  .left {
    padding: 1.75rem 1.5rem;
  }
  .logo-badge {
    width: 72px;
    height: 72px;
    margin-bottom: 1rem;
  }
  .left h1 {
    font-size: 1.4rem;
  }
  .subtitle {
    max-width: 320px;
  }
  .right {
    padding: 1.75rem;
  }
  body.loginpage {
    background-attachment: scroll;
  }
}
@media (max-width: 480px) {
  .login-page {
    padding: 16px;
  }
  .login-card {
    border-radius: 14px;
  }
  .left {
    padding: 1.5rem 1.25rem;
  }
  .right {
    padding: 1.5rem;
  }
}
.page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.page-head h2 {
  font-size: 28px;
  font-weight: 700;
  color: #111827;
  margin-bottom: 4px;
}
.page-head .desc {
  font-size: 14px;
  color: #6b7280;
}
.page-head .page-actions {
  display: flex;
  gap: 10px;
}

.quick-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.request-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 20px;
}

.request-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.request-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.request-name {
  font-weight: 600;
  color: #111827;
}

.request-count {
  font-size: 13px;
  color: #16a34a;
  font-weight: 600;
}

.request-bar {
  height: 8px;
  background: #ecfdf5;
  border-radius: 999px;
  overflow: hidden;
}
.request-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #22c55e, #16a34a);
}

.item-code-chip {
  display: inline-block;
  font-family: "Courier New", Courier, monospace;
  font-size: 11.5px;
  color: #6b7280;
  background: #f4f6f5;
  border: 1px solid #e5e7eb;
  padding: 2px 8px;
  border-radius: 4px;
  letter-spacing: 0.03em;
}

.qty-ok {
  color: #16a34a;
  font-weight: 700;
}

.qty-low {
  color: #d97706;
  font-weight: 700;
}

.qty-out {
  color: #dc2626;
  font-weight: 700;
}

#itemModal .modal-head {
  background: #f0fdf4;
  border-radius: 16px 16px 0 0;
  border-bottom-color: #dcfce7;
}
#itemModal .modal-head h3 {
  color: #14532d;
}

.qty-unit-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.qty-unit-row input {
  flex: 1;
}
.qty-unit-row .unit-label {
  font-size: 12px;
  color: #6b7280;
  white-space: nowrap;
}

.reorder-hint {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px 12px;
  background: #fef3c7;
  border-left: 3px solid #d97706;
  border-radius: 0 6px 6px 0;
  font-size: 12px;
  color: rgb(167.3721973094, 91.7847533632, 4.6278026906);
  margin-top: 6px;
}

.inventory-empty {
  text-align: center;
  padding: 56px 20px;
  color: #7c8592;
}
.inventory-empty .empty-icon {
  font-size: 52px;
  margin-bottom: 14px;
}
.inventory-empty p {
  font-size: 14px;
  max-width: 320px;
  margin: 0 auto 18px;
}

#viewModal .modal-body .form-group label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #6b7280;
}

.item-details-grid {
  display: grid;
  grid-template-columns: 1fr 220px;
  gap: 28px;
  align-items: start;
}

.item-preview {
  width: 100%;
  aspect-ratio: 1;
  -o-object-fit: cover;
     object-fit: cover;
  border-radius: 10px;
  border: 1px solid #e5e7eb;
  background: #fff;
}

.item-details-right {
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

@media (max-width: 760px) {
  .item-details-grid {
    grid-template-columns: 1fr;
  }
  .item-details-right {
    order: -1;
  }
  .item-preview {
    max-width: 220px;
  }
}
.pending-row {
  border-left: 3px solid #d97706;
}
.pending-row td:first-child {
  padding-left: 11px;
}
.pending-row.overdue {
  border-color: #dc2626;
}

.issuance-actions {
  display: flex;
  gap: 6px;
  flex-wrap: nowrap;
}
.issuance-actions .btn {
  min-width: 74px;
  justify-content: center;
}

.avail-label {
  font-size: 11px;
  color: #7c8592;
  margin-top: 2px;
}
.avail-label.avail-low {
  color: #d97706;
}
.avail-label.avail-out {
  color: #dc2626;
}

#tab-manual .panel {
  border-top: 3px solid #16a34a;
}

.iss-id-chip {
  font-family: "Courier New", monospace;
  font-size: 11.5px;
  background: #f4f6f5;
  border: 1px solid #e5e7eb;
  padding: 2px 7px;
  border-radius: 4px;
  color: #6b7280;
}

.tabs .badge {
  vertical-align: middle;
  margin-left: 6px;
  font-size: 10px;
}

.issuance-empty {
  text-align: center;
  padding: 48px 20px;
  color: #7c8592;
}
.issuance-empty .empty-icon {
  font-size: 44px;
  margin-bottom: 12px;
}
.issuance-empty p {
  font-size: 13.5px;
}

.bar-issued {
  background: #16a34a !important;
}

.bar-received {
  background: #2563eb !important;
}

.chart-legend-row {
  display: flex;
  gap: 18px;
  font-size: 11.5px;
  margin-bottom: 10px;
}
.chart-legend-row .legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
}
.chart-legend-row .legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 3px;
}

.stock-bar-wrap {
  width: 80px;
  height: 6px;
  background: #e5e7eb;
  border-radius: 3px;
  overflow: hidden;
  display: inline-block;
  vertical-align: middle;
  margin-right: 6px;
}
.stock-bar-wrap .stock-bar {
  height: 100%;
  border-radius: 3px;
  transition: width 0.35s ease;
}
.stock-bar-wrap .stock-bar.ok {
  background: #16a34a;
}
.stock-bar-wrap .stock-bar.low {
  background: #d97706;
}
.stock-bar-wrap .stock-bar.out {
  background: #dc2626;
}

.priority-critical {
  color: #dc2626;
  font-weight: 700;
}

.priority-medium {
  color: #d97706;
  font-weight: 600;
}

.priority-low {
  color: #6b7280;
  font-weight: 500;
}

#restockModal input[type=number]:focus {
  border-color: #16a34a;
  box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.15);
}

.stock-all-clear {
  text-align: center;
  padding: 56px 20px;
  color: #16a34a;
}
.stock-all-clear .icon {
  font-size: 52px;
  margin-bottom: 12px;
}
.stock-all-clear p {
  font-size: 14px;
  color: #6b7280;
}

.stat-card .stat-value.critical {
  color: #dc2626;
}
.stat-card .stat-value.low-val {
  color: #d97706;
}
.stat-card .stat-value.healthy {
  color: #16a34a;
}

.report-gen-form {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr auto;
  align-items: end;
  gap: 14px;
  flex-wrap: wrap;
}
@media (max-width: 760px) {
  .report-gen-form {
    grid-template-columns: 1fr 1fr;
  }
}

.user-table-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #dcfce7;
  color: #14532d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 11px;
  flex-shrink: 0;
  border: 2px solid #f0fdf4;
}

.user-name-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}
.user-name-cell .name {
  font-weight: 600;
  font-size: 13.5px;
}

.badge-role-admin {
  background: #dbeafe;
  color: #2563eb;
  font-weight: 700;
}

.badge-role-user {
  background: #f4f6f5;
  color: #6b7280;
  font-weight: 600;
}

.user-stat-card {
  border-top: 3px solid transparent;
}
.user-stat-card.total-card {
  border-color: #2563eb;
}
.user-stat-card.active-card {
  border-color: #16a34a;
}
.user-stat-card.admin-card {
  border-color: #d97706;
}
.user-stat-card.inactive-card {
  border-color: #e5e7eb;
}

.password-callout {
  padding: 10px 12px;
  background: #f0fdf4;
  border-left: 3px solid #16a34a;
  border-radius: 0 6px 6px 0;
  font-size: 12px;
  color: #14532d;
  margin-top: 6px;
}

.current-user-row td:first-child::after {
  content: " (you)";
  font-size: 10px;
  color: #16a34a;
  font-weight: 700;
}

.users-filter-bar {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}
.users-filter-bar select {
  min-width: 140px;
}

.dashboard-page {
  background: linear-gradient(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5)), url("../img/Userbg.png") center center/cover no-repeat fixed;
}

.dashboard-container {
  max-width: 980px;
  margin: auto;
  margin-top: 16px;
  background: #fff;
  border-radius: 20px;
  padding: 28px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

.user-hero {
  text-align: center;
  margin-bottom: 28px;
}

.user-hero h1 {
  font-size: 26px;
  color: #16a34a;
  font-weight: 700;
  margin-bottom: 5px;
}
.user-hero h1 span {
  color: #1f2937;
}

.hero-divider {
  width: 70px;
  height: 4px;
  border-radius: 999px;
  background: #16a34a;
  margin: auto auto 15px;
}

.user-search {
  position: relative;
  width: 100%;
  max-width: 560px;
  margin: auto;
}

.user-search .search-icon {
  position: absolute;
  left: 22px;
  top: 50%;
  transform: translateY(-50%);
  color: #9ca3af;
  font-size: 16px;
  z-index: 2;
}

.user-search input {
  width: 100%;
  height: 46px;
  border-radius: 999px;
  border: 1px solid #d1d5db;
  padding: 0 65px 0 50px;
  font-size: 15px;
  background: #fff;
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
}
.user-search input:hover {
  border-color: #16a34a;
  box-shadow: 0 8px 22px rgba(22, 163, 74, 0.15);
}

.user-search input:focus {
  outline: none;
  border-color: #16a34a;
  box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.12), 0 8px 22px rgba(22, 163, 74, 0.18);
}

.user-search button {
  position: absolute;
  right: 3px;
  top: 3px;
  width: 40px;
  height: 40px;
  border: none;
  font-size: 16px;
  border-radius: 50%;
  background: #16a34a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

@media (max-width: 900px) {
  .category-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 768px) {
  .dashboard-page {
    padding: 20px;
  }
  .dashboard-container {
    padding: 28px;
  }
  .user-hero h1 {
    font-size: 28px;
  }
  .category-card {
    min-height: 140px;
  }
}
.user-content {
  max-width: 1200px;
  margin: 24px auto 40px;
  padding: 0 20px;
}

.category-banner {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  margin-bottom: 20px;
  box-shadow: 0 1px 2px rgba(16, 24, 16, 0.06);
}
.category-banner .category-icon-lg {
  width: 56px;
  height: 56px;
  background: #dcfce7;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  flex-shrink: 0;
}
.category-banner h2 {
  font-size: 19px;
  margin-bottom: 3px;
}
.category-banner p {
  color: #6b7280;
  font-size: 13px;
}

.item-card {
  transition: box-shadow 0.2s ease, transform 0.2s ease;
  cursor: default;
}
.item-card:hover {
  box-shadow: 0 4px 14px rgba(16, 24, 16, 0.08);
  transform: translateY(-2px);
}

.item-card.out-of-stock {
  opacity: 0.72;
  pointer-events: auto;
}
.item-card.out-of-stock .item-image {
  filter: grayscale(60%);
}

.item-card .qty {
  font-size: 20px;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 4px;
}
.item-card .qty small {
  font-size: 12px;
  font-weight: 400;
  color: #6b7280;
  margin-left: 3px;
}

#detailsModal .modal-head {
  background: #f0fdf4;
  border-radius: 16px 16px 0 0;
}
#detailsModal .modal-head h3 {
  color: #14532d;
}

#detailsModal .modal {
  width: 520px;
  max-width: 90%;
  min-height: 350px;
}
#detailsModal .item-details-grid {
  display: grid;
  grid-template-columns: 1fr 220px;
  gap: 18px;
  align-items: start;
}
#detailsModal .item-details-left {
  min-width: 0;
}
#detailsModal .form-group {
  margin-bottom: 14px;
}
#detailsModal .form-group label {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  color: #94a3b8;
  font-weight: 600;
  margin-bottom: 5px;
}
#detailsModal .form-group div {
  font-size: 14px;
  color: #0f172a;
}
#detailsModal .form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}
#detailsModal .item-details-right {
  display: flex;
  justify-content: flex-end;
}
#detailsModal .item-preview {
  width: 220px;
  height: 220px;
  -o-object-fit: contain;
     object-fit: contain;
  border-radius: 10px;
  border: 1px solid #e5e7eb;
  background: #fff;
}
#detailsModal .no-image {
  width: 220px;
  height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #d1d5db;
  border-radius: 10px;
  color: #94a3b8;
}

@media (max-width: 760px) {
  #detailsModal .item-details-grid {
    grid-template-columns: 1fr;
  }
  #detailsModal .item-details-right {
    order: -1;
    justify-content: center;
  }
  #detailsModal .item-preview,
  #detailsModal .no-image {
    width: 100%;
    max-width: 220px;
  }
  #detailsModal .form-row {
    grid-template-columns: 1fr;
  }
}
#requestModal #req_item_name {
  background: #f4f6f5;
  color: #6b7280;
  cursor: not-allowed;
}

.category-filter-bar {
  display: grid;
  grid-template-columns: minmax(250px, 1fr) 180px 180px auto;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  margin-bottom: 22px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  box-shadow: 0 1px 2px rgba(16, 24, 16, 0.06);
}
.category-filter-bar .search-grow {
  width: 100%;
}
.category-filter-bar .form-control {
  height: 42px;
  width: 100%;
  border-radius: 10px;
}
.category-filter-bar .btn {
  height: 42px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 10px;
}

@media (max-width: 800px) {
  .category-filter-bar {
    grid-template-columns: 1fr;
  }
}
.category-empty {
  text-align: center;
  padding: 60px 20px;
  color: #7c8592;
  grid-column: 1/-1;
}
.category-empty .empty-icon {
  font-size: 48px;
  margin-bottom: 14px;
}
.category-empty p {
  font-size: 14px;
}

.panel {
  padding: 16px 20px;
  margin-bottom: 18px;
}
.panel .flex {
  display: flex;
  align-items: center;
  gap: 18px;
}
.panel .stat-icon {
  width: 54px;
  height: 54px;
  border-radius: 14px;
  font-size: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.panel .category-heading h2 {
  margin: 0 0 3px;
  font-size: 19px;
  font-weight: 700;
  line-height: 1.2;
}
.panel .category-heading p {
  margin: 0;
  font-size: 13px;
  color: #6b7280;
  line-height: 1.5;
}

.search-inline-form {
  display: flex;
  align-items: center;
  gap: 0;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 999px;
  box-shadow: 0 1px 2px rgba(16, 24, 16, 0.06);
  padding: 6px 6px 6px 20px;
  margin-bottom: 24px;
}
.search-inline-form input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 14.5px;
  color: #1f2937;
  min-width: 0;
}
.search-inline-form input::-moz-placeholder {
  color: #7c8592;
}
.search-inline-form input::placeholder {
  color: #7c8592;
}
.search-inline-form input:focus {
  outline: none;
}
.search-inline-form button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #16a34a;
  color: #ffffff;
  border: none;
  font-size: 16px;
  flex-shrink: 0;
  transition: background 0.15s;
}
.search-inline-form button:hover {
  background: #15803d;
}

.results-heading {
  font-size: 14.5px;
  color: #6b7280;
  margin-bottom: 16px;
}
.results-heading strong {
  color: #1f2937;
  font-weight: 700;
}
.results-heading .kw-pill {
  display: inline-block;
  background: #dcfce7;
  color: #14532d;
  padding: 1px 8px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  margin-left: 4px;
}

.search-no-results {
  grid-column: 1/-1;
  text-align: center;
  padding: 60px 20px;
  color: #7c8592;
}
.search-no-results .empty-icon {
  font-size: 52px;
  margin-bottom: 14px;
}
.search-no-results p {
  font-size: 14px;
  max-width: 320px;
  margin: 0 auto 18px;
}
.search-no-results .suggestions {
  font-size: 13px;
  color: #6b7280;
  list-style: disc;
  display: inline-block;
  text-align: left;
  padding-left: 20px;
}
.search-no-results .suggestions li {
  margin-bottom: 4px;
}

.item-card .category-crumb {
  font-size: 11px;
  color: #7c8592;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.item-card .category-crumb .cat-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #16a34a;
  display: inline-block;
}

.item-card {
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.item-card:hover {
  box-shadow: 0 4px 14px rgba(16, 24, 16, 0.08);
  transform: translateY(-2px);
}

.search-prompt {
  grid-column: 1/-1;
  text-align: center;
  padding: 48px 20px;
  color: #7c8592;
  font-size: 14px;
}
.search-prompt .prompt-icon {
  font-size: 44px;
  margin-bottom: 12px;
}

.requests-page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  flex-wrap: wrap;
  gap: 12px;
}
.requests-page-head h3 {
  font-size: 16px;
}
.requests-page-head .back-link {
  font-size: 13px;
  color: #6b7280;
}

.req-row-pending {
  border-left: 3px solid #d97706;
}
.req-row-pending td:first-child {
  padding-left: 11px;
}

.req-row-approved {
  border-left: 3px solid #16a34a;
}
.req-row-approved td:first-child {
  padding-left: 11px;
}

.req-row-rejected {
  border-left: 3px solid #dc2626;
}
.req-row-rejected td:first-child {
  padding-left: 11px;
}
.req-row-rejected {
  opacity: 0.75;
}

.status-dot-wrap {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12.5px;
  font-weight: 600;
}
.status-dot-wrap .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.status-dot-wrap.pending {
  color: #d97706;
}
.status-dot-wrap.pending .dot {
  background: #d97706;
}
.status-dot-wrap.approved {
  color: #16a34a;
}
.status-dot-wrap.approved .dot {
  background: #16a34a;
}
.status-dot-wrap.rejected {
  color: #dc2626;
}
.status-dot-wrap.rejected .dot {
  background: #dc2626;
}

.req-item-cell .item-name {
  font-weight: 600;
  font-size: 13px;
}
.req-item-cell .item-code {
  font-family: "Courier New", monospace;
  font-size: 11px;
  color: #7c8592;
  margin-top: 2px;
}

.requests-empty {
  text-align: center;
  padding: 64px 24px;
  color: #7c8592;
}
.requests-empty .empty-icon {
  font-size: 52px;
  margin-bottom: 16px;
}
.requests-empty p {
  font-size: 14px;
  max-width: 280px;
  margin: 0 auto 18px;
}
.requests-empty a {
  color: #16a34a;
  font-weight: 600;
}

.date-processed-cell {
  color: #7c8592;
  font-size: 12px;
}

.date-requested-cell {
  color: #6b7280;
  font-size: 12px;
}/*# sourceMappingURL=main.css.map */